map $http_upgrade $flyreq_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${FLYREQ_DOMAIN};

    include /etc/nginx/flyreq-cloudflare-realip.conf;
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:${FLYREQ_HOST_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $flyreq_connection_upgrade;
        proxy_read_timeout 300s;
    }
}
